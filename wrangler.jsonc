{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gita-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",

  // nodejs_compat gives the Worker Node built-ins Next's server runtime expects.
  // Payment code deliberately avoids Node APIs anyway (fetch + Web Crypto only),
  // so the money path doesn't depend on this shim.
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Serve the site at the subdomain. custom_domain:true makes Cloudflare create
  // the proxied DNS record and issue the TLS cert. The root vrnda.store stays on
  // Shopify (untouched) — only this subdomain points at the Worker.
  "routes": [
    { "pattern": "gita.vrnda.store", "custom_domain": true }
  ],

  "observability": {
    "enabled": true
  }

  // Secrets are NOT set here — this file is committed. Set them with
  // `wrangler secret put <NAME>` (see docs/DEPLOY.md).
}
